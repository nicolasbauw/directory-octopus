# Maintainer: Nicolas BAUW <bauw.nicolas@gmail.com>
pkgname=directory-octopus-git
pkgver=1.0.0.r19.d9e4fab
pkgrel=1
pkgdesc="Retro-inspired dual-pane file manager (git version)"
arch=('x86_64')
url="https://github.com/nicolasbauw/directory-octopus"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'upx' 'git')
provides=('directory-octopus')
conflicts=('directory-octopus')
source=("$pkgname::git+https://github.com/nicolasbauw/directory-octopus.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    if _ver=$(git describe --long --tags 2>/dev/null); then
        printf '%s' "$_ver" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "1.0.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked
    upx --best target/release/directory_octopus
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/directory_octopus "$pkgdir/usr/bin/directory-octopus"
    install -Dm644 packaging/directory-octopus.desktop \
        "$pkgdir/usr/share/applications/directory-octopus.desktop"
    install -Dm644 assets/icon.png \
        "$pkgdir/usr/share/pixmaps/directory-octopus.png"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
